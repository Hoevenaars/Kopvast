RESEND_API_KEY=
# Geverifieerd Kopvast-domein in Resend. Geen onboarding@resend.dev: die sandbox
# levert alleen af op het e-mailadres van het Resend-account.
RESEND_FROM_EMAIL="Kopvast <contact@kopvast.nl>"
CONTACT_TO_EMAIL=contact@kopvast.nl
# Webhook-secret voor delivered/bounced/failed. Alleen server-side.
RESEND_WEBHOOK_SECRET=

# Website Refresh (intern prospect-project). Alleen server-side, nooit NEXT_PUBLIC_.
WEBSITE_REFRESH_SUPABASE_URL=https://exnprzhtxnxlrntlcsnh.supabase.co
WEBSITE_REFRESH_SERVICE_ROLE_KEY=
# Optioneel. Zonder sleutel wordt de URL wel opgeslagen, maar draait de AI niet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Acquisitie-outreach. Lokaal blijft TEST, tenzij je hier LIVE zet.
# In productie wint de modus onder Admin → Instellingen (app_settings.email_mode).
EMAIL_MODE=TEST
EMAIL_TEST_ADDRESS=contact@kopvast.nl

# Klant- en adminconsole. Alleen server-side. In productie verplicht.
KOPVAST_SESSION_SECRET=
KOPVAST_ADMIN_EMAILS=contact@kopvast.nl

# Kopvast Scout — https://scout.kopvast.nl
# Productie-origin. Geen hostname hardcoden in applicatiecode.
NEXT_PUBLIC_APP_URL=https://scout.kopvast.nl
# Optioneel. Zelfde project als Website Refresh mag.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact één toegestaan account. Server-side allowlist, nooit alleen frontend.
ALLOWED_USER_ID=
ALLOWED_EMAILS=contact@kopvast.nl
# Vercel Cron Authorization: Bearer CRON_SECRET
CRON_SECRET=
# Preview deployments krijgen geen production-processing tenzij je dit zet.
SCOUT_PREVIEW_PROCESSING=false
